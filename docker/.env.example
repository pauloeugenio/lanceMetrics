# Copie para docker/.env para guardar as configurações desta instalação.
LANCE_HTTP_PORT=8080
LANCE_IPERF_PORT=5201
LANCE_VIDEO_PORT_RANGE=5000-5018
LANCE_AUTH_ENABLED=false
# Padrão: build local. Para uma imagem publicada, informe sua referência:
LANCE_IMAGE=lancemetrics:local
# LANCE_IMAGE=USUARIO/lancemetrics:latest
